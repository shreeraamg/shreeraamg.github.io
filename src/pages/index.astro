---
import Layout from '../layouts/Layout.astro'
import Hero from '../components/Hero.astro'
import { navigation } from '../data/navigation'
---

<Layout>
  <Hero />
  <section class="directory container" aria-labelledby="directory-heading">
    <h2 id="directory-heading" class="eyebrow">Explore the field guide</h2>
    <ul>
      {navigation.map(page => (
        <li>
          <a href={page.href}>
            <span class="page-name">{page.label}<span aria-hidden="true">&#8599;</span></span>
            <span class="page-description">{page.description}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Layout>

<style>
  .directory { border-top: 1px solid var(--color-border); padding-block: 2rem 3rem; }
  ul { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem 4rem; list-style: none; margin: 1.5rem 0 0; padding: 0; }
  a { display: block; text-decoration: none; }
  .page-name { display: flex; align-items: center; justify-content: space-between; font-family: var(--font-display); font-size: 1.6rem; line-height: 1.3; }
  .page-name > span { font-family: var(--font-body); font-size: 1rem; color: var(--color-accent); transition: transform 160ms ease; }
  a:hover .page-name { text-decoration: underline; text-underline-offset: 5px; }
  a:hover .page-name > span { transform: translate(2px, -2px); }
  .page-description { display: block; font-size: 0.95rem; color: var(--color-text-secondary); margin-top: 0.5rem; max-width: 48ch; }
  @media (max-width: 760px) {
    ul { grid-template-columns: 1fr; gap: 1.5rem; }
  }
</style>