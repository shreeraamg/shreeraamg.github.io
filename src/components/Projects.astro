---
import { portfolio } from '../data/portfolio'
---

<section id="projects">
  <div class="container">
    <div class="section-header fade-in">
      <p class="section-label">Work</p>
      <h2 class="section-title">Projects</h2>
    </div>

    <div class="projects-grid">
      {portfolio.projects.map((project) => (
        <article
          class="project-card card fade-in"
          role="link"
          tabindex="0"
          onclick={`window.open("${project.liveUrl ?? project.githubUrl}", "_blank")`}
          onkeypress={`if (event.key === 'Enter' || event.key === ' ') { window.open("${project.liveUrl ?? project.githubUrl}", "_blank"); }`}
        >
          <div class="project-top">
            <div class="project-icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>
              </svg>
            </div>
            <div class="project-links">
              {project.githubUrl && (
                <a href={project.githubUrl} target="_blank" rel="noopener noreferrer" aria-label="GitHub" onclick="event.stopPropagation()">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
                  </svg>
                </a>
              )}
            </div>
          </div>

          <h3 class="project-name">{project.name}</h3>
          <p class="project-desc">{project.description}</p>

          <div class="project-stack">
            {project.techStack.map((tech) => (
              <span class="tech-tag">{tech}</span>
            ))}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  section {
    padding: 6rem 1.5rem;
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
  }

  .section-header {
    margin-bottom: 3rem;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .project-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .project-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .project-card {
    cursor: pointer;
  }

  .project-card:focus {
    outline: 3px solid var(--color-accent);
    outline-offset: 3px;
  }

  .project-icon {
    color: var(--color-accent);
  }

  .project-links {
    display: flex;
    gap: 0.75rem;
  }

  .project-links a {
    color: var(--color-text-muted);
    transition: color 0.2s;
  }

  .project-links a:hover {
    color: var(--color-accent);
  }

  .project-name {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .project-desc {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.65;
    flex: 1;
  }

  .project-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-border);
  }

  .tech-tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-accent);
    background-color: color-mix(in srgb, var(--color-accent) 10%, transparent);
    padding: 0.2rem 0.6rem;
    border-radius: 100px;
  }
</style>