---
import type { CollectionEntry } from "astro:content";
import ArrowUpRight from "./ArrowUpRight.astro";

interface Props {
  note: CollectionEntry<"notes">;
  headingLevel?: "h2" | "h3";
}

const { note, headingLevel: Heading = "h2" } = Astro.props;
---

<article class="note-card" aria-labelledby={`note-${note.id}`}>
  <p class="eyebrow">
    {note.data.kind === "work" ? "Professional work" : "Personal project"}
    / {note.data.category}
  </p>
  <Heading id={`note-${note.id}`}>{note.data.title}</Heading>
  <p class="summary">{note.data.summary}</p>
  <p class="outcome"><strong>Outcome</strong> {note.data.outcome}</p>
  <a class="text-link" href={`/notes/${note.id}/`}>
    <span>Read the note<span class="sr-only">: {note.data.title}</span></span>
    <span class="arrow" aria-hidden="true"><ArrowUpRight /></span>
  </a>
</article>

<style>
  .note-card {
    border-top: 1px solid var(--color-border);
    padding-block: 1.5rem;
    min-width: 0;
  }
  h2,
  h3 {
    font-family: var(--font-display);
    font-size: clamp(1.65rem, 2.5vw, 2rem);
    font-weight: 400;
    line-height: 1.2;
    margin-block: 0.75rem;
  }
  .summary {
    color: var(--color-text-secondary);
  }
  .outcome {
    margin-block: 1rem 0.5rem;
  }
  .outcome strong {
    font-weight: 500;
    color: var(--color-accent);
    margin-right: 0.35rem;
  }
</style>
