---
import { portfolio } from "../data/portfolio";
import ArrowUpRight from "./ArrowUpRight.astro";

const socialLabels: Record<string, string> = {
  github: "GitHub",
  linkedin: "LinkedIn",
};
const socialLinks = Object.entries(portfolio.social ?? {}).map(
  ([key, href]) => {
    const url = new URL(href);
    return {
      label: socialLabels[key] ?? key,
      href,
      address: `${url.hostname}${url.pathname}`,
    };
  },
);
---

<section
  id="contact"
  class="chapter container"
  aria-labelledby="contact-heading"
>
  <div class="reading-grid">
    <div>
      <p class="section-label">Get in touch</p>
      <h1 id="contact-heading" class="section-title">Contact</h1>
    </div>
    <div class="contact-copy">
      <p>
        Have an interesting problem, an opportunity, or something you're
        building? I'd like to hear about it.
      </p>
      <p>Email is the best way to reach me.</p>
      <a href={`mailto:${portfolio.email}`} class="email-link"
        >{portfolio.email} <span aria-hidden="true"><ArrowUpRight /></span></a
      >
      <div class="resume-link">
        <a href={portfolio.resumeUrl} class="text-link"
          ><span>View my resume</span><span class="arrow" aria-hidden="true"
            ><ArrowUpRight /></span
          ></a
        >
      </div>
    </div>
  </div>
  <div class="elsewhere reading-grid">
    <h2>Elsewhere</h2>
    <ul>
      {
        socialLinks.map((link) => (
          <li>
            <a href={link.href} target="_blank" rel="noopener noreferrer">
              <span class="social-name">
                {link.label}
                <span aria-hidden="true">
                  <ArrowUpRight />
                </span>
              </span>
              <span class="social-address">{link.address}</span>
              <span class="sr-only"> (opens in a new tab)</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .contact-copy > p {
    max-width: 52ch;
    color: var(--color-text-secondary);
    font-size: 1rem;
    margin-bottom: 1.25rem;
  }
  .email-link {
    font-size: 1.1rem;
    color: var(--color-accent);
    overflow-wrap: anywhere;
  }
  .email-link span {
    margin-left: 0.3rem;
  }
  .resume-link {
    margin-top: 1rem;
  }
  .elsewhere {
    border-top: 1px solid var(--color-border);
    padding-top: 2.5rem;
    margin-top: 3rem;
  }
  h2 {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 400;
    line-height: 1.2;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  li + li {
    border-top: 1px solid var(--color-border);
  }
  li a {
    display: block;
    padding-block: 1rem;
    text-decoration: none;
  }
  li:first-child a {
    padding-top: 0;
  }
  .social-name {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-weight: 500;
  }
  .social-name > span {
    color: var(--color-accent);
  }
  li a:hover .social-name {
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .social-address {
    display: block;
    color: var(--color-text-secondary);
    font-size: 0.875rem;
    overflow-wrap: anywhere;
    margin-top: 0.35rem;
  }
</style>
