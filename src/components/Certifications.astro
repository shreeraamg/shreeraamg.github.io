---
import { portfolio } from '../data/portfolio'
---

<section id="certifications">
  <div class="container">
    <div class="section-header fade-in">
      <p class="section-label">Credentials</p>
      <h2 class="section-title">Certifications</h2>
    </div>

    <div class="certs-grid">
      {portfolio.certifications.map((cert) => (
        <div
          class="cert-card card fade-in"
          role={cert.credentialUrl ? "link" : undefined}
          tabindex={cert.credentialUrl ? "0" : undefined}
          onclick={cert.credentialUrl ? `window.open("${cert.credentialUrl}", "_blank")` : undefined}
          onkeypress={cert.credentialUrl ? `if (event.key === 'Enter' || event.key === ' ') { window.open("${cert.credentialUrl}", "_blank"); }` : undefined}
        >
          <div class="cert-icon">
            <img src={cert.icon} alt={cert.issuer} width="32" height="32" loading="lazy" class={cert.invert ? 'invert-dark' : ''} />
          </div>
          <div class="cert-info">
            <h3 class="cert-name">{cert.name}</h3>
            <p class="cert-meta">
              <span>{cert.issuer}</span>
              <span class="cert-dot" aria-hidden="true">·</span>
              <span class="cert-year">{cert.year}</span>
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  section {
    padding: 6rem 1.5rem;
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
  }

  .section-header {
    margin-bottom: 3rem;
  }

  .certs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
  }

  .cert-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.125rem 1.25rem;
  }

  .cert-card {
    cursor: default;
  }

  .cert-card[role="link"] {
    cursor: pointer;
  }

  .cert-card[role="link"]:focus {
    outline: 3px solid var(--color-accent);
    outline-offset: 3px;
  }

  .cert-icon {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-bg-secondary);
    border-radius: 10px;
    padding: 8px;
  }

  .cert-icon img {
    width: 28px;
    height: 28px;
    object-fit: contain;
  }

  .cert-info {
    flex: 1;
    min-width: 0;
  }

  .cert-name {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-text-primary);
    line-height: 1.3;
    margin-bottom: 0.25rem;
  }

  .cert-meta {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }

  .cert-year {
    color: var(--color-accent);
    font-family: var(--font-mono);
  }

  .cert-dot {
    color: var(--color-border);
  }


  @media (prefers-color-scheme: dark) {
    .invert-dark {
      filter: invert(1);
    }
  }

  [data-theme="dark"] .invert-dark {
    filter: invert(1);
  }
</style>