---
import { portfolio } from '../data/portfolio'
---

<section id="certifications" class="chapter container" aria-labelledby="credentials-heading">
  <div class="section-heading">
    <div>
      <p class="section-label">Continuing education</p>
      <h2 id="credentials-heading" class="section-title">Certifications</h2>
    </div>
    <p class="section-intro">Certifications &amp; courses along the way.</p>
  </div>
  <ul class="credentials">
    {(portfolio.certifications ?? []).map((cert) => (
      <li>
        <span class="cert-year">{cert.year}</span>
        <div>
          <h3>
            {cert.credentialUrl ? (
              <a href={cert.credentialUrl} target="_blank" rel="noopener noreferrer">
                {cert.name} <span class="credential-arrow" aria-hidden="true">&#8599;</span>
                <span class="sr-only"> (opens in a new tab)</span>
              </a>
            ) : cert.name}
          </h3>
          <p>{cert.issuer}</p>
        </div>
      </li>
    ))}
  </ul>
</section>

<style>
  .credentials { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: clamp(2rem, 5vw, 4rem); list-style: none; padding: 0; margin: 0; }
  li { display: flex; align-items: baseline; gap: 1.5rem; border-top: 1px solid var(--color-border); padding-block: 1.4rem; }
  .cert-year { font-family: var(--font-mono); font-size: 0.8rem; color: var(--color-accent); flex-shrink: 0; }
  h3 { font-size: 1rem; font-weight: 500; line-height: 1.6; }
  h3 a { text-decoration: none; display: inline-block; }
  h3 a:hover { text-decoration: underline; }
  .credential-arrow { color: var(--color-accent); margin-left: 0.25rem; }
  li p { font-size: 0.875rem; color: var(--color-text-muted); margin-top: 0.25rem; }
  @media (max-width: 760px) { .credentials { grid-template-columns: 1fr; } }
</style>
