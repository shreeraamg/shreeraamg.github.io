---
import { portfolio } from '../data/portfolio'
---

<section id="certifications">
  <div class="container">
    <div class="section-header fade-in">
      <p class="section-label">Credentials</p>
      <h2 class="section-title">Certifications</h2>
    </div>

    <div class="certs-grid">
      {portfolio.certifications.map((cert) => (
        <div class="cert-card card fade-in">
          <div class="cert-icon">
            <img src={cert.icon} alt={cert.issuer} width="32" height="32" loading="lazy" />
          </div>
          <div class="cert-info">
            <h3 class="cert-name">{cert.name}</h3>
            <p class="cert-meta">
              <span>{cert.issuer}</span>
              <span class="cert-dot" aria-hidden="true">·</span>
              <span class="cert-year">{cert.year}</span>
            </p>
          </div>
          {cert.credentialUrl && (
            <a href={cert.credentialUrl} target="_blank" rel="noopener noreferrer" class="cert-link" aria-label="View credential">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" x2="21" y1="14" y2="3"/>
              </svg>
            </a>
          )}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  section {
    padding: 6rem 1.5rem;
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
  }

  .section-header {
    margin-bottom: 3rem;
  }

  .certs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
  }

  .cert-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.125rem 1.25rem;
  }

  .cert-icon {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-bg-secondary);
    border-radius: 10px;
    padding: 8px;
  }

  .cert-icon img {
    width: 28px;
    height: 28px;
    object-fit: contain;
  }

  .cert-info {
    flex: 1;
    min-width: 0;
  }

  .cert-name {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-text-primary);
    line-height: 1.3;
    margin-bottom: 0.25rem;
  }

  .cert-meta {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }

  .cert-year {
    color: var(--color-accent);
    font-family: var(--font-mono);
  }

  .cert-dot {
    color: var(--color-border);
  }

  .cert-link {
    flex-shrink: 0;
    color: var(--color-text-muted);
    transition: color 0.2s;
  }

  .cert-link:hover {
    color: var(--color-accent);
  }
</style>