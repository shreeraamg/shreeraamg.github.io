---
import { portfolio } from '../data/portfolio'
---

<section id="about">
  <div class="container">
    <div class="about-grid">
      <div class="about-left fade-in">
        <p class="section-label">About</p>
        <h2 class="section-title">Who I am</h2>
      </div>
      <div class="about-right fade-in">
        <p class="about-text">{portfolio.about}</p>

        <div class="about-stats">
          <div class="stat">
            <span class="stat-number">2+</span>
            <span class="stat-label">Years experience</span>
          </div>
          <div class="stat">
            <span class="stat-number">80+</span>
            <span class="stat-label">Microservices maintained</span>
          </div>
          <div class="stat">
            <span class="stat-number">3</span>
            <span class="stat-label">Certifications</span>
          </div>
        </div>

        <div class="about-edu">
          <p class="edu-label">Education</p>
          <p class="edu-degree">B.E. Mechanical Engineering</p>
          <p class="edu-school">SRM Easwari Engineering College · 2019 – 2023</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  section {
    padding: 6rem 1.5rem;
    background-color: var(--color-bg-secondary);
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 4rem;
    align-items: start;
  }

  .about-left {
    position: sticky;
    top: 5rem;
  }

  .about-text {
    font-size: 1.0625rem;
    color: var(--color-text-secondary);
    line-height: 1.8;
    margin-bottom: 2.5rem;
    font-weight: 300;
  }

  .about-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-bottom: 2.5rem;
    padding: 1.5rem;
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 12px;
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .stat-number {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--color-accent);
    line-height: 1;
  }

  .stat-label {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    line-height: 1.3;
  }

  .about-edu {
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .edu-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    margin-bottom: 0.5rem;
  }

  .edu-degree {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-text-primary);
    margin-bottom: 0.25rem;
  }

  .edu-school {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .about-left {
      position: static;
    }

    .about-stats {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>