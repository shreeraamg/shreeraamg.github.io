---
import { portfolio } from '../data/portfolio'
---

<section id="about">
  <div class="container">
    <div class="about-grid">
      <div class="about-left fade-in">
        <p class="section-label">About</p>
        <h2 class="section-title">Who I am</h2>
      </div>
      <div class="about-right fade-in">
        <p class="about-text">{portfolio.about}</p>

        <div class="about-interests">
          <h3>Interests</h3>
          <ul>
            {portfolio.interests.map((interest) => (
              <li>{interest}</li>
            ))}
          </ul>
        </div>

        <div class="about-stats">
          <div class="stat">
            <span class="stat-number">2+</span>
            <span class="stat-label">Years experience</span>
          </div>
          <div class="stat">
            <span class="stat-number">{portfolio.certifications.length}</span>
            <span class="stat-label">Certifications</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  section {
    padding: 6rem 1.5rem;
    background-color: var(--color-bg-secondary);
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 4rem;
    align-items: start;
  }

  .about-left {
    position: sticky;
    top: 5rem;
  }

  .about-text {
    font-size: 1.0625rem;
    color: var(--color-text-secondary);
    line-height: 1.8;
    margin-bottom: 2.5rem;
    font-weight: 300;
  }

  .about-interests {
    margin-bottom: 2.5rem;
  }

  .about-interests h3 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text-primary);
    margin-bottom: 0.75rem;
  }

  .about-interests ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .about-interests li {
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 20px;
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    color: var(--color-text-secondary);
  }

  .about-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-bottom: 2.5rem;
    padding: 1.5rem;
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 12px;
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .stat-number {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--color-accent);
    line-height: 1;
  }

  .stat-label {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    line-height: 1.3;
  }

  .about-edu {
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
  }

  .edu-school {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
  }

  @media (max-width: 768px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .about-left {
      position: static;
    }

    .about-stats {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>