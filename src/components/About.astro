---
import { portfolio } from '../data/portfolio'
---

<section id="about" class="chapter container" aria-labelledby="about-heading">
  <div class="about-grid reading-grid">
    <div>
      <p class="section-label">A little background</p>
      <h1 id="about-heading" class="section-title">About me</h1>
      <p class="location eyebrow">Based in Chennai, India</p>
    </div>
    <div class="about-copy">
      <p class="about-lead">I'm {portfolio.name}, a software engineer drawn to the parts of a system you don't see &mdash; but depend on every day.</p>
      <p>{portfolio.about}</p>
      <div class="interests">
        <p class="eyebrow">Things I keep coming back to</p>
        <ul>{(portfolio.interests ?? []).map((interest) => <li>{interest}</li>)}</ul>
      </div>
      <a href={portfolio.resumeUrl} class="text-link"><span>The full story / Resume</span><span class="arrow" aria-hidden="true">&#8599;</span></a>
    </div>
  </div>
</section>

<style>
  .location { margin-top: 1.7rem; }
  .about-copy > p { font-size: 1rem; color: var(--color-text-secondary); margin-bottom: 1.25rem; max-width: 52ch; }
  .about-copy .about-lead { font-size: 1.15rem; color: var(--color-text-primary); line-height: 1.65; }
  .interests { margin-block: 2rem 1rem; padding-top: 1.25rem; border-top: 1px solid var(--color-border); }
  ul { display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; padding: 0; margin: 0.75rem 0 0; list-style: none; }
  li { font-size: 0.95rem; }
  li::before { content: '+'; color: var(--color-accent); margin-right: 0.5rem; }
</style>
