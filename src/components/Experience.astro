---
import { portfolio } from '../data/portfolio'

function fmtMonthYear(d) {
  if (!d) return '';
  if (d === 'present') return 'Present';
  const date = d instanceof Date ? d : new Date(d);
  if (isNaN(date)) return '';
  return date.toLocaleString('en-US', { month: 'short', year: 'numeric' });
}
---

<section id="experience">
  <div class="container">
    <div class="section-header fade-in">
      <p class="section-label">Career</p>
      <h2 class="section-title">Experience</h2>
    </div>

    <div class="timeline">
      {portfolio.experience.map((job) => (
        <div class="timeline-item fade-in">
          <div class="timeline-dot"></div>
          <div class="timeline-content card">
            <div class="job-header">
              <div>
                <h3 class="job-role">{job.role}</h3>
                <p class="job-company">{job.company} · {job.location}</p>
              </div>
              <span class="job-duration">{fmtMonthYear(job.startDate)} - {job.endDate === 'present' || job.endDate == null ? 'Present' : fmtMonthYear(job.endDate)}</span>
            </div>
            <ul class="job-highlights">
              {job.highlights.map((point) => (
                <li>
                  <span class="bullet" aria-hidden="true">—</span>
                  {point}
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  section {
    padding: 6rem 1.5rem;
    background-color: var(--color-bg-secondary);
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
  }

  .section-header {
    margin-bottom: 3rem;
  }

  .timeline {
    position: relative;
    padding-left: 1.5rem;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 0;
    top: 8px;
    bottom: 8px;
    width: 1px;
    background-color: var(--color-border);
  }

  .timeline-item {
    position: relative;
    margin-bottom: 2rem;
  }

  .timeline-dot {
    position: absolute;
    left: -1.875rem;
    top: 1.25rem;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: var(--color-accent);
    border: 2px solid var(--color-bg-secondary);
  }

  .timeline-content {
    transition: border-color 0.2s;
  }

  .job-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }

  .job-role {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-text-primary);
    margin-bottom: 0.25rem;
  }

  .job-company {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .job-duration {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-accent);
    white-space: nowrap;
    padding: 0.25rem 0.625rem;
    border: 1px solid color-mix(in srgb, var(--color-accent) 30%, transparent);
    border-radius: 100px;
  }

  .job-highlights {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .job-highlights li {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    line-height: 1.65;
    display: flex;
    gap: 0.75rem;
  }

  .bullet {
    color: var(--color-accent);
    flex-shrink: 0;
    margin-top: 0.05rem;
  }
</style>