---
import { engineeringStudies, portfolio } from '../data/portfolio'

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' })
---

<section id="experience" class="chapter container" aria-labelledby="work-heading">
  <div class="section-heading">
    <div>
      <p class="section-label">Professional work</p>
      <h1 id="work-heading" class="section-title">Experience</h1>
    </div>
    <p class="section-intro">My work in backend engineering, with a closer look at a few problems I've helped solve.</p>
  </div>

  <div class="career-record">
    {(portfolio.experience ?? []).map((job) => (
      <div class="job">
        <div class="job-heading reading-grid">
          <div><h2>{job.role}</h2><p>{job.company} / {job.location}</p></div>
          <p class="job-date">{formatDate(job.startDate)} &mdash; {job.endDate instanceof Date ? formatDate(job.endDate) : 'Present'}</p>
        </div>
        <details class="disclosure">
          <summary>View all contributions</summary>
          <ul>{job.highlights.map((highlight) => <li>{highlight}</li>)}</ul>
        </details>
      </div>
    ))}
  </div>

  <div class="studies">
    {engineeringStudies.map((study, index) => (
      <article class="study reading-grid">
        <div class="study-copy">
          <p class="eyebrow"><span class="study-number">{study.number}</span> / {study.category}</p>
          <h2>{study.title}</h2>
          <p class="study-description">{study.constraint}</p>
          <p class="study-outcome">{study.outcome}</p>
          <details class="disclosure">
            <summary>Read the engineering note<span class="sr-only">: {study.title}</span></summary>
            <dl>
              <dt>The decision</dt><dd>{study.decision}</dd>
            </dl>
          </details>
        </div>
        {index === 0 ? (
          <figure class="integration-figure">
            <div class="figure-label">Integration / Before &amp; after</div>
            <div class="comparison">
              <div class="before">
                <p class="eyebrow">Before</p>
                <div class="interface-grid" aria-hidden="true">
                  {Array.from({ length: 12 }, () => <span />)}
                </div>
                <p>Per-interface<br />codebases &amp; images</p>
              </div>
              <span class="converge" aria-hidden="true">&#8594;</span>
              <div class="after">
                <p class="eyebrow">After</p>
                <div class="unified" aria-hidden="true"><span>1</span><small>shared service</small></div>
                <p>Configuration-driven<br />integration</p>
              </div>
            </div>
            <figcaption><strong>{study.metric}</strong><span>{study.metricLabel}<small>Conceptual illustration, not internal architecture.</small></span></figcaption>
          </figure>
        ) : (
          <div class="study-metric">
            <strong>{study.metric}</strong>
            <span>{study.metricLabel}</span>
          </div>
        )}
      </article>
    ))}
  </div>

</section>

<style>
  .study { padding-block: 2.5rem; border-top: 1px solid var(--color-border); }
  .study:last-child { padding-bottom: 0; }
  .study-number { color: var(--color-accent); }
  .study h2 { font-family: var(--font-display); font-size: clamp(1.9rem, 3vw, 2.4rem); font-weight: 400; line-height: 1.15; letter-spacing: -0.02em; margin-block: 1rem; max-width: 24ch; }
  .study-description { font-size: 1rem; color: var(--color-text-secondary); margin-bottom: 1rem; max-width: 52ch; }
  .study-outcome { font-size: 1rem; margin-bottom: 1.25rem; max-width: 52ch; }
  .disclosure { border-bottom: 0; }
  dl { margin: 0 0 1rem; font-size: 1rem; }
  dt { color: var(--color-accent); font-size: 0.75rem; font-family: var(--font-mono); text-transform: uppercase; margin-block: 1rem 0.4rem; }
  dd { margin: 0; color: var(--color-text-secondary); }
  .integration-figure { border: 1px solid var(--color-border); background: var(--color-bg-secondary); padding: 1.5rem; }
  .comparison { display: grid; grid-template-columns: 1fr auto 1fr; gap: 1rem; align-items: center; padding-block: 2rem; text-align: center; }
  .comparison p:not(.eyebrow) { font-size: 0.875rem; color: var(--color-text-secondary); }
  .interface-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 5px; height: 83px; margin: 1rem auto; max-width: 122px; }
  .interface-grid span { background: #e1dfd4; border: 1px solid #a7aa9a; }
  .unified { display: flex; flex-direction: column; justify-content: center; border: 1px solid var(--color-accent); background: #eddfd2; height: 83px; margin: 1rem auto; max-width: 122px; color: var(--color-accent); }
  .unified span { font-family: var(--font-display); font-size: 2rem; line-height: 1; }
  .unified small { font-size: 0.75rem; margin-top: 0.4rem; }
  .converge { color: var(--color-accent); font-size: 1.5rem; }
  figcaption { border-top: 1px solid var(--color-border); padding-top: 1rem; display: flex; align-items: center; gap: 1rem; }
  figcaption strong, .study-metric strong { font-family: var(--font-display); font-size: 3rem; font-weight: 400; line-height: 1; color: var(--color-accent); }
  figcaption span { font-size: 0.95rem; }
  figcaption small { display: block; font-size: 0.8rem; color: var(--color-text-muted); margin-top: 0.4rem; }
  .study-metric { display: flex; align-items: center; gap: 1.25rem; border-left: 2px solid var(--color-border); padding: 1rem 1.5rem; }
  .study-metric span { max-width: 200px; font-size: 1rem; color: var(--color-text-secondary); }
  .career-record { border-top: 1px solid var(--color-border); padding-block: 1.75rem; }
  .job-heading { margin-bottom: 1.25rem; align-items: center; }
  .job h2 { font-size: 1.15rem; font-weight: 500; }
  .job-heading div p { font-size: 1rem; color: var(--color-text-secondary); margin-top: 0.25rem; }
  .job-date { font-size: 0.95rem; color: var(--color-text-secondary); }
  ul { padding-left: 1.1rem; margin: 0 0 1rem; max-width: 80ch; }
  li { font-size: 1rem; color: var(--color-text-secondary); margin-bottom: 0.8rem; padding-left: 0.35rem; }
  li::marker { color: var(--color-accent); }
  @media (max-width: 760px) {
    .study { padding-block: 2rem; }
    .integration-figure { padding: 1rem; }
    .job-heading { gap: 0.5rem; }
    .comparison { gap: 0.6rem; }
  }
</style>
